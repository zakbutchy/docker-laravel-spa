[mysqld]
# データベースファイルの格納先
datadir = /var/lib/mysql
# mysqldを実行するOSユーザー
user = mysql
# クライアント/サーバー間でやり取りできる1パケットあたりの最大サイズ
max_allowed_packet = 16MB

# character set / collation
# デフォルトの文字セット
character_set_server = utf8mb4
# 日本語向けの照合順序（アクセント・大文字小文字を区別）
collation_server = utf8mb4_ja_0900_as_cs_ks

# timezone
# OS（コンテナ）のタイムゾーンに従う
default-time-zone = SYSTEM
log_timestamps = SYSTEM

# Error Log
# `log-error` を明示指定すると起動オプション解析中の初期エラーが握りつぶされることがあるため、
# 未指定のままイメージのデフォルト（stderr）に任せる

# Slow Query Log
# ログファイルパスは絶対パスで指定すること。相対パスだとentrypointのchown処理が暴走する
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/mysql-slow.log
# この秒数を超えたクエリを「スロークエリ」として記録する
long_query_time = 1.0
# インデックスを使用していないだけのクエリまではログしない
log_queries_not_using_indexes = 0

# 全クエリを記録する（開発時の動作確認用。I/O負荷が高いため本番では無効化すること）
general_log = 1
general_log_file = /var/lib/mysql/mysql-general.log

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
