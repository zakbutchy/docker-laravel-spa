# Laravelインストール後、この内容をserver/.envに該当するキーを置き換える形でコピーすること
#
# DB_DATABASE / DB_USERNAME / DB_PASSWORD は、mysqlコンテナが実際に初期化された値と
# 一致させること（docker-compose.ymlのmysqlサービスを参照）
# ここを変更したら、そちらも合わせて変更すること

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

# ログ設定（daily: 日次でファイルを分割、14日分を保持）
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=test_db
DB_USERNAME=testuser
DB_PASSWORD=password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# キューワーカー（Horizon等）を使うならredisに変更（デフォルトのdatabaseドライバのままでも動作はする）
QUEUE_CONNECTION=redis
